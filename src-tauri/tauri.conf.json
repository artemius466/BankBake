{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BankBake",
  "version": "1.1.2",
  "identifier": "com.bankbake.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BankBake",
        "width": 1020,
        "height": 760,
        "minWidth": 780,
        "minHeight": 580,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
